# ============================================================================
# HireStation + Docuseal, using your EXISTING Invoice Ninja (not run by this stack).
#   cp .env.no-invoiceninja.example .env   → fill in the values below →   docker compose up -d --build
# Connect your Invoice Ninja in the setup wizard (its URL + an API token).
# Infrastructure only: business details and API tokens are entered in the setup wizard.
# ============================================================================
COMPOSE_FILE=docker-compose.yml:docker-compose.docuseal.yml

# --- HireStation --------------------------------------------------------------
SESSION_SECRET=generate-a-long-random-string-of-at-least-32-chars   # openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# HireStation's address as users reach it: https://hire.example.com in production, or
# http://<server-ip>:3000 for LAN testing. Invoice Ninja webhooks (automatic Sent/Paid updates)
# only work when this resolves to a PUBLIC IP; Invoice Ninja refuses private addresses.
PUBLIC_URL=https://hire.example.com
# Which address the apps listen on:
#   127.0.0.1 = only this server (use with a reverse proxy on the same machine: production)
#   0.0.0.0   = any machine on your network can connect by IP (e.g. http://192.168.1.50:3000)
# For LAN testing without HTTPS, see README → Deploy → "Option A".
APP_BIND=127.0.0.1
APP_PORT=3000
# TRUST_PROXY=loopback,linklocal,uniquelocal

# --- Docuseal -----------------------------------------------------------------
DOCUSEAL_HOST=sign.example.com
DOCUSEAL_DB_PASSWORD=change-me
DOCUSEAL_BIND=127.0.0.1                   # 0.0.0.0 for LAN access by IP
DOCUSEAL_PORT=3001
DOCUSEAL_FORCE_SSL=true                   # set false when using plain http (no HTTPS proxy)
# DOCUSEAL_SMTP_ADDRESS=smtp.example.com
# DOCUSEAL_SMTP_PORT=587
# DOCUSEAL_SMTP_USERNAME=
# DOCUSEAL_SMTP_PASSWORD=
# DOCUSEAL_SMTP_DOMAIN=example.com
# DOCUSEAL_SMTP_FROM=contracts@example.com

# --- Backups ------------------------------------------------------------------
BACKUP_PATH=./backups
BACKUP_KEEP_DAYS=14
