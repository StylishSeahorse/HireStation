# Caddy (automatic HTTPS). Replace the hostname with your subdomain.
# Caddy forwards Host / X-Forwarded-For / X-Forwarded-Proto by default.
hire.example.com {
	encode zstd gzip

	# Uploads (logo, equipment photos) are capped at 10 MB by the app.
	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:3000
}

# Bundled Docuseal (docker-compose.docuseal.yml). Must match DOCUSEAL_HOST.
sign.example.com {
	encode zstd gzip
	request_body {
		max_size 50MB
	}
	reverse_proxy 127.0.0.1:3001
}
