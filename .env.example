# Infrastructure-only settings. NEVER put business details, bank details,
# brand assets or Invoice Ninja / Docuseal credentials here — those are
# entered through the setup wizard and stored in the database.
# Local dev only — docker-compose builds DATABASE_URL/REDIS_URL from the values below.
DATABASE_URL=postgresql://hirestation:change-me@localhost:5432/hirestation
SESSION_SECRET=generate-a-long-random-string-of-at-least-32-chars
REDIS_URL=redis://localhost:6379
STORAGE_PATH=./storage
PORT=3000
# Hops allowed to set X-Forwarded-* (default: loopback + private networks). See deploy/README.md
# TRUST_PROXY=loopback,linklocal,uniquelocal
# Public base URL of this app (used to build webhook URLs shown in Settings)
PUBLIC_URL=http://localhost:3000

# docker-compose
POSTGRES_PASSWORD=change-me
# Host interface/port the app is published on (keep 127.0.0.1 behind a reverse proxy)
APP_BIND=127.0.0.1
APP_PORT=3000
BACKUP_PATH=./backups
BACKUP_KEEP_DAYS=14
