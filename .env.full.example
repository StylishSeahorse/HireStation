# ============================================================================
# FULL STACK: HireStation + Docuseal + Invoice Ninja, all in this compose project.
#   cp .env.full.example .env   → fill in the values below →   docker compose up -d --build
# Infrastructure only: business details and API tokens are entered in the setup wizard.
# ============================================================================
COMPOSE_FILE=docker-compose.yml:docker-compose.docuseal.yml:docker-compose.invoiceninja.yml

# --- HireStation --------------------------------------------------------------
SESSION_SECRET=generate-a-long-random-string-of-at-least-32-chars   # openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# HireStation's public https address. Must resolve to a PUBLIC IP (Invoice Ninja refuses
# to register webhooks to private addresses).
PUBLIC_URL=https://hire.example.com
APP_BIND=127.0.0.1
APP_PORT=3000
# TRUST_PROXY=loopback,linklocal,uniquelocal

# --- Docuseal -----------------------------------------------------------------
DOCUSEAL_HOST=sign.example.com
DOCUSEAL_DB_PASSWORD=change-me
DOCUSEAL_PORT=3001
DOCUSEAL_FORCE_SSL=true
# DOCUSEAL_SMTP_ADDRESS=smtp.example.com
# DOCUSEAL_SMTP_PORT=587
# DOCUSEAL_SMTP_USERNAME=
# DOCUSEAL_SMTP_PASSWORD=
# DOCUSEAL_SMTP_DOMAIN=example.com
# DOCUSEAL_SMTP_FROM=contracts@example.com

# --- Invoice Ninja --------------------------------------------------------------
IN_URL=https://invoices.example.com
IN_PORT=3002
# Generate once and keep it (it encrypts Invoice Ninja data):
#   docker run --rm invoiceninja/invoiceninja-debian php artisan key:generate --show
IN_APP_KEY=base64:REPLACE_ME
IN_DB_PASSWORD=change-me
IN_DB_ROOT_PASSWORD=change-me-too
# Invoice Ninja admin, created on first boot:
IN_USER_EMAIL=admin@example.com
IN_PASSWORD=change-me-Str0ng!
# IN_MAIL_HOST=smtp.example.com
# IN_MAIL_PORT=587
# IN_MAIL_USERNAME=
# IN_MAIL_PASSWORD=
# IN_MAIL_ENCRYPTION=tls
# IN_MAIL_FROM_ADDRESS=invoices@example.com
# IN_MAIL_FROM_NAME=

# --- Backups ------------------------------------------------------------------
BACKUP_PATH=./backups
BACKUP_KEEP_DAYS=14
